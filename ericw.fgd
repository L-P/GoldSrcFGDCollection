@BaseClass = CompilerWorldspawnBase
[
	_bounce(integer) : "Bounce" : 0 : "Non-zero enables bounce lighting, disabled by default. The value is the maximum number of bounces to perform."
	_bouncecolorscale(choices) : "Bounce color" : 0 : "Weight for bounce lighting to use texture colors from the map: 0=ignore map textures (default), 1=multiply bounce light color by texture color." =
	[
		0 : "Ignore textures"
		1 : "Use texture color"
	]
	_bouncescale(float) : "Bounce scale" : "1" : "Scales brightness of bounce lighting."
	_bouncestyled(choices) : "Bounce styled" : 1 : "1 allows styled lights to bounce (e.g. flickering or switchable lights).." =
	[
		0 : "Do not bounce styled lights"
		1 : "Bounce styled lights"
	]
	_dirtangle(float) : "Dirt angle" : "88" : "Cone angle in degrees for occlusion testing. Allowed range 1-90. Lower values can avoid unwanted dirt on arches, pipe interiors, etc."
	_dirtdepth(integer) : "Dirt depth" : 128 : "Maximum depth of occlusion checking for dirtmapping, default 128."
	_dirtgain(float) : "Dirt gain" : "1" : "Exponent used in dirt calculation. Lower values (e.g. 0.5) make the shadows darker and stretch further away from corners."
	_dirtscale(float) : "Dirt scale" : "1" : "Scale factor used in dirt calculations. Lower values (e.g. 0.5) make the dirt fainter, 2.0 would create much darker shadows."
	_dist(integer) : "Scale fade distance" : : "Scales the fade distance of all lights by a factor of n. If n > 1 lights fade more quickly with distance and if n < 1, lights fade more slowly with distance and light reaches further."
	_dirtmode(choices) : "Dirt mode" : 0 =
	[
		0 : "Ordered"
		1 : "Randomizer"
	]
	_gamma(float) : "Gamma" : "1" : "Adjust brightness of final lightmap. >1 is brighter, <1 is darker."
	_minlight(integer) : "Min light" : 0 : "Set a global minimum light level of “n” across the whole map. This is an easy way to eliminate completely dark areas of the level, however you may lose some contrast as a result, so use with care."
	_minlight_color(string) : "Min light color" : "255 255 255" : "Specify red(r), green(g) and blue(b) components for the colour of the minlight. RGB component values are between 0 and 255 (between 0 and 1 is also accepted)."
	_minlight_dirt(choices) : "Min light dirt" : 0 : "1 enables dirtmapping (ambient occlusion) on minlight, -1 to disable. Default is to use the value of “_dirt”." =
	[
		-1 : "Disable"
		0 : "Use _dirt value"
		1 : "Enable"
	]
	_range(integer) : "Scale range" : : "Scales the brightness range of all lights without affecting their fade discance. Values of n > 0.5 makes lights brighter and n < 0.5 makes lights less bright. The same effect can be achieved on individual lights by adjusting both the “light” and “wait” attributes."
	_surflight_atten(float) : "1" : "Undocumented."
	_surflight_minlight_scale(float) : "Surflight min light scale" : "1" : "Scale factor for automatic minlight on an emissive face, derived from the light color being emitted.\nThis is intended to prevent, e.g., a light fixture texture which is configured as a surface light, from being completely black.\nCan set to 0.0 to disable minlight."
	_spotlightautofalloff(choices) : "Spotlight auto falloff" : 0 :  "When set to 1, spotlight falloff is calculated from the distance to the targeted info_null. Ignored when “_falloff” is not 0." =
	[
		0 : "No"
		1 : "Yes"
	]
	_surface_radiosity(choices) : "Surface mode" : 1 : "Whether to use Q1-style surface subdivision (0) or Q2-style surface radiosity." =
	[
		0 : "Q1 surface subdivision"
		1 : "Q2 surface radiosity"
	]
]

@BaseClass = CompilerSolidClassBase
[
	// Replaces the deprecated _chop since v2.0.0.
	_chop_order(integer) : "Chop order" : 0 : "Override the order of brushes in the map file, which affects which face “wins” in the CSG phase when there are multiple overlapping coplanar brushes. Provided since most .map editors don’t directly expose the brush order.\nAll brushes are initially 0; setting this to 1 would make a brush appear after anything in the map file, and so clip away coplanar faces from other brushes.\nFor example, you could make a func_group with “_chop_order” “1”, and apply it to a light fixture which is coplanar with a floor or ceiling, to ensure the light fixture is visible in-game, without going to the trouble of cutting a hole in the floor/ceiling for it."
	_hulls(flags) : "Hulls" : 0 : "Bitmap that selects for which hulls collision data will be generated. eg. a decimal value of 11 (0b1011) would generate hull 0, hull 1, and hull 3. Faces are computed using data from hull 0, not generating this hull will prevent a bmodel from being rendered, acting as a CLIP brush only active for the specified hulls.\n0 will generate clipnodes for all hulls." =
	[
		1 : "Hull 0 (point)" : 0
		2 : "Hull 1 (human)" : 0
		4 : "Hull 2 (large)" : 0
		8 : "Hull 3 (crouched/small)" : 0
	]
	_lmscale(integer) : "LM scale" : : "Generates an LMSHIFT bspx lump for use by a light util. Note that both scaled and unscaled lighting will normally be used."
	_mirrorinside(choices) : "Mirror inside faces" : 0 : "Set to 1 to save mirrored inside faces for bmodels, so when the player view is inside the bmodel, they will still see the faces. (e.g. for func_water, func_illusionary, func_detail_illusionary, func_detail_fence, etc.)" =
	[
		0 : "No"
		1 : "Yes"
	]
	_noclipfaces(choices) : "Don't clip faces" : 0 : "Set to 1 to suppress the usual qbsp behaviour where two touching brushes of the same content type will have the touching portion clipped away.\nThis is useful for things that can be seen inside, such as func_detail_illusionary, func_detail_fence, liquids, bmodels, etc.\nBehaviour is unspecified for coplanar faces." =
	[
		0 : "No"
		1 : "Yes"
	]
	_object_channel_mask(integer) : "Light channel mask" : 1 : "Mask of lighting channels that this bmodel receives light on, blocks light on, and tests for AO on.\nChanging this from 1 will disable bouncing light off of this bmodel.\nChanging this from 1 implicitly enables _shadow.\nChanging to 2, for example, will cause the bmodel to initially be solid black. You’ll need to add minlight or lights with _light_channel_mask 2."


	_minlight(integer) : "Min light" : 0 : "Set the minimum light level for any surface of the brush model."
	_minlight_mottle(choices) : "Min light mottle" : 0 : "Whether minlight should have a mottled pattern." =
	[
		0 : "No"
		1 : "Yes"
	]
	_minlight_exclude(string) : "Minlight exclude 1" : : "Faces with the given texture are excluded from receiving minlight on this brush model."
	_minlight_exclude2(string) : "Minlight exclude 2" : : "Faces with the given texture are excluded from receiving minlight on this brush model."
	_minlight_exclude3(string) : "Minlight exclude 3" : : "Faces with the given texture are excluded from receiving minlight on this brush model."
	_minlight_color(string) : "Min light color" : "255 255 255" : "Specify red(r), green(g) and blue(b) components for the colour of the minlight. RGB component values are between 0 and 255 (between 0 and 1 is also accepted)."

	_shadow(choices) : "Cast shadows" : 1 : "If n is 1, this model will cast shadows on other models and itself (i.e. “_shadow” implies “_shadowself”). Note that this doesn’t magically give GoldSrc dynamic lighting powers, so the shadows will not move if the model moves. Set to -1 on func_detail/func_group to prevent them from casting shadows." =
	[
		0 : "No"
		1 : "Yes"
	]

	_shadowself(choices) : "Cast shadows on self" : 1 : "If n is 1, this model will cast shadows on itself if one part of the model blocks the light from another model surface. This can be a better compromise for moving models than full shadowing." =
	[
		0 : "No"
		1 : "Yes"
	]
	_shadowworldonly(choices) : "Cast shadows on self" : 1 : "If n is 1, this model will cast shadows on the world only (not other bmodels)." =
	[
		0 : "No"
		1 : "Yes"
	]

	_dirt(choices) : "Ambient occlusion" : 0 : "For brush models, -1 prevents dirtmapping on the brush model. Useful if the bmodel touches or sticks into the world, and you want to prevent those areas from turning black." =
	[
		-1 : "No"
		0 : "Yes"
	]

	_phong(choices) : "Phong" : 0 : "1 enables phong shading on this model with a default _phong_angle of 89 (softens columns etc)." =
	[
		0 : "No"
		1 : "Yes"
	]
	_phong_angle(float) : "Phong angle" : "89" : "Enables phong shading on faces of this model with a custom angle. Adjacent faces with normals this many degrees apart (or less) will be smoothed. Consider setting “_anglescale” to “1” on lights or worldspawn to make the effect of phong shading more visible. Use the “-phongdebug” command-line flag to save the interpolated normals to the lightmap for previewing)."
	_phong_angle_concave(float) : "Phong angle concave" : : "Optional key for setting a different angle threshold for concave joints. A pair of faces will either use “_phong_angle” or “_phong_angle_concave” as the smoothing threshold, depending on whether the joint between the faces is concave or not. “_phong_angle(_concave)” is the maximum angle (in degrees) between the face normals that will still cause the pair of faces to be smoothed. The minimum setting for “_phong_angle_concave” is 1, this should make all concave joints non-smoothed (unless they’re less than 1 degree apart, almost a flat plane.) If it’s 0 or unset, the same value as “_phong_angle” is used."
	_phong_group(integer) : "Phong group" : : "Integer specifying a “smoothing group ID” for phong shading. Default 0, faces with a _phong_group will only smooth with faces with a matching _phong_group."
	_lightignore(choices) : "Ignore light" : 0 : "1 makes a model receive minlight only, ignoring all lights / sunlight. Could be useful on rotators / trains. Lighting Channels for a more powerful version of this." =
	[
		0 : "No"
		1 : "Yes"
	]
	_light_twosided(choices) : "Light two sided" : 0 : "Set to 1 to enable receiving light from either side." =
	[
		0 : "No"
		1 : "Yes"
	]
	_light_alpha(float) : "Light alpha" : "1" : "Range 0-1 Allows customizing the opacity of this face when it’s acting as “stained glass”."
	_surflight_atten(float) : "Surflight attenuation" : : "Overrides the worldspawn key _surflight_atten for these brushes."
	_surflight_rescale(choices) : "Surflight rescale" : : "If 1, rescales any surface light emitted by these brushes to emit 50% light at 90 degrees from the surface normal. Otherwise, use a more natural angle falloff of 0% at 90 degrees." =
	[
		0 : "No"
		1 : "Yes"
	]
	_surflight_color(string) : "Surflight color" : "255 255 255" : "Customize the emissive color of a surface light. Default is to use the average texture color."
	_surflight_style(choices) : "Surflight style" : 0 : "Override the surface light lightstyle number for light emitted from these brushes." =
	[
		0 : "Normal"
		10: "Fluorescent flicker"
		2 : "Slow, strong pulse"
		11: "Slow pulse, noblack"
		5 : "Gentle pulse"
		1 : "Flicker A"
		6 : "Flicker B"
		3 : "Candle A"
		7 : "Candle B"
		8 : "Candle C"
		4 : "Fast strobe"
		9 : "Slow strobe"
	]
	_surflight_targetname(string) : "Surflight targetname" : : "Override the surface light targetname for light emitted from these brushes."
	_surflight_minlight_scale(float) : "Surflight min light scale" : : "Overrides the worldspawn setting _surflight_minlight_scale"
	_bounce(choices) : "Bounce" : : "Set to -1 to prevent this model from bouncing light (i.e. prevents its brushes from emitting bounced light they receive from elsewhere.) Only has an effect if “_bounce” is enabled in worldspawn." =
	[
		-1 : "No"
		0 : "Yes"
	]
	_autominlight(choices) : "Auto min light" : : "“Autominlight” is a feature for automatically choosing a suitable minlight color for a bmodel entity (e.g. a func_door), by averaging incoming light at the center of the bmodel bounding box.\nDefault behaviour is to apply autominlight on occluded luxels only (e.g., for a door that opens vertically upwards, it would apply to the bottom face of the door, which is initially pressed against the ground).\nA value of “-1” disables the feature (occluded luxels will be solid black), and “1” enables it as a minlight color even on non-occluded luxels." =
	[
		-1 : "Disable"
		0 : "Occluded only"
		1 : "Enable"
	]
	_autominlight_target(target_destination) : "Auto min light target" : : "For autominlight, instead of using the center of the model bounds as the sample point, searches for an entity with its “targetname” key set to “name”, and use that entity’s origin (typically you’d use an “info_null” for this)."
	_surflight_group(integer) : "Surflight group" : 0 : "Can be set to a nonzero value to make these brushes emit as surface lights only from a light template with a matching _surflight_group value."
	_lightcolorscale(float) : "Light color scale" : "1" : "Saturation control as a postprocessing step on these specific faces’ lightmaps.\n0.0 is fully desaturated to greyscale."
]

@BaseClass = CompilerLightBase
[
	_anglescale(float) : "Angle scale" : "0.5" : "Sets a scaling factor for how much influence the angle of incidence of light on a surface has on the brightness of the surface. n must be between 0.0 and 1.0. Smaller values mean less attenuation, with zero meaning that angle of incidence has no effect at all on the brightness."
	_bouncescale(float) : "Bounce scale" : "1.0" : "Scales the amount of light that is contributed by bounces, 0.0 disables bounce lighting for this light."
	_color(color) : "Color" : "255 255 255" : "Specify red(r), green(g) and blue(b) components for the colour of the light. RGB component values are between 0 and 255 (between 0 and 1 is also accepted)."
	_deviance(integer) : "Deviance" : 0 : "Split up the light into a sphere of randomly positioned lights within radius “n” (in world units). Useful to give shadows a wider penumbra. “_samples” specifies the number of lights in the sphere. The “light” value is automatically scaled down for most lighting formulas (except linear and non-additive minlight) to attempt to keep the brightness equal."
	_dirt(choices) : "Ambient occlusion" : 0 : "Overrides the worldspawn setting of “_dirt” for this particular light. -1 to disable dirtmapping (ambient occlusion) for this light, making it illuminate the dirtmapping shadows. 1 to enable ambient occlusion for this light." =
	[
		-1 : "Disable"
		0 : "Inherit worldspawn settings"
		1 : "Enable"
	]
	_dirtscale(float) : "Dirt scale" : : "Override the global “_dirtscale” or “_dirtgain” settings to change how this light is affected by dirtmapping (ambient occlusion). See descriptions of these keys in the worldspawn section."
	_falloff(integer) : "Falloff" : : "Sets the distance at which the light drops to 0, in map units.\nIn this mode, “wait” is ignored and “light” only controls the brightness at the center of the light, and no longer affects the falloff distance.\nOnly supported on linear attenuation (delay 0) lights currently."
	_light_channel_mask(integer) : "Light channel mask" : 1 : "Mask of lighting channels that the light casts on.\nIn order for this light to cast light on a bmodel, there needs to be a least 1 bit in common between _light_channel_mask and the receiving bmodel’s _object_channel_mask (i.e. the bitwise AND must be nonzero).\nCurrently, bounced light, surface lights, and sunlight are always on channel 1."
	_nostaticlight(choices) : "No static light" : 0 : "Set to 1 to make the light compiler ignore this entity (prevents it from casting any light). e.g. could be useful with rtlights." =
	[
		0 : "No"
		1 : "Yes"
	]
	_samples(integer) : "Deviance samples" : 16 : "Number of lights to use for “_deviance”, only used if “_deviance” is set)."
	_shadow_channel_mask(integer) : "Shadow channel mask" : : "This is the mask of lighting channels that will block this entity’s light rays. If the the bitwise AND of this and another bmodel’s _object_channel_mask is nonzero, the light ray is stopped.\nThis is an advanced option, for making bmodels only cast shadows for specific lights (but not others).\nDefaults to _light_channel_mask"
	_switchableshadow_target(target_destination) : "Switchable shadow target" : : "Calculate lighting with and without bmodels with a “targetname” equal to “name”, and stores the resulting switchable shadow data in a light style which is stored in this light entity’s “style” key.\nYou should give this light a targetname and typically set “spawnflags” “1” (start off).\nImplies _nostaticlight (this entity itself does not cast any light).\nIf your mod supports it, you should prefer to use bmodel key _switchableshadow to enable switchable shadows."
	delay(choices) : "Attenuation formula" : 1 =
	[
		0 : "Linear attenuation (default)"
		1 : "1/x attenuation"
		2 : "1/(x^2) attenuation"
		3 : "No attenuation (same brightness at any distance)"
		4 : "'local minlight', no attenuation and like minlight, it won't raise the lighting above it's light value. Unlike minlight, it will only affect surfaces within line of sight of the entity."
		5 : "1/(x^2) attenuation, but slightly more attenuated and without the extra bright effect that 'delay 2' has near the source."
	]
	light(integer) : "Brightness" : 300 : "The common form is one value, n, which sets the light intensity. Negative values are also allowed and will cause the entity to subtract light cast by other entities.\nFor Half-Life compatibility, you can specify a color here before the light value, in the same format as _color.\n_color takes priority if a color is set in both places."
	wait(integer) : "Fade distance" : 1 : "Scale the fade distance of the light by “n”. Values of n > 1 make the light fade more quickly with distance, and values < 1 make the light fade more slowly (and thus reach further)."
]

@BaseClass base(CompilerLightBase) = CompilerLightSpotBase
[
	_softangle(float) : "Inner cone" : "0" : "Specifies the angle in degrees for an inner spotlight cone (must be less than the “angle” cone. Creates a softer transition between the full brightness of the inner cone to the edge of the outer cone. 0 to disable."
	angle(float) : "Outer cone" : "40" : "Specifies the angle in degrees for a spotlight cone."
	mangle(string) : "Angles" : : "Turns the light into a spotlight and specifies the direction of light using yaw, pitch and roll in degrees. Yaw specifies the angle around the Z-axis from 0 to 359 degrees and pitch specifies the angle from 90 (straight up) to -90 (straight down). Roll has no effect, so use any value (e.g. 0). Often easier than the “target” method."
	target(target_destination) : "Target" : : "Turns the light into a spotlight, with the direction of light being towards another entity with it’s “targetname” key set to “name”."
]

@PointClass base(CompilerLightBase) = light_surface : "Texture light"
[
	_project_fov(float) : "Project FoV" : "90" : "Specifies the fov angle for a texture projection. Default 90."
	_project_mangle(string) : "Project angles" : : "Specifies the yaw/pitch/roll angles for a texture projection (overriding mangle)."
	_project_texture(string) : "Project texture" : : "Specifies that a light should project this texture. The texture must be used in the map somewhere."
	_surface(string) : "Texture name" : : "Makes surfaces with the given texture name emit light, by using this light as a template which is copied across those surfaces. Lights are spaced about 128 units (though possibly closer due to bsp splitting) apart and positioned 2 units above the surfaces.\nTo restrict this surface light config to a subset of brushes with the “texturename” texture applied, see the _surflight_group key."
	_surface_offset(float) : "Surface offset" : "2" : "Controls the offset lights are placed above surfaces for _surface."
	_surflight_group(integer) : "Suflight group" : : "For use with _surface lights.\nCan be set to a nonzero value to restrict this surface light template to only emit from brushes with a matching _surflight_group value."
	_surface_radiosity(choices) : "Surface mode" : : "Whether to use Q1-style surface subdivision (0) or Q2-style surface radiosity (1) on this light specifically.\nUse in conjunction with _surface.\nThe default can be changed for all surface lights in a map with worldspawn key _surflight_radiosity." =
	[
		0 : "Q1 surface subdivision"
		1 : "Q2 surface radiosity"
	]
	_surface_spotlight(choices) : "Spot" : 0 : "Setting this to “1” makes each instance into a spotlight, with the direction of light pointing along the surface normal. In other words, it automatically sets “mangle” on each of the generated lights." =
	[
		0 : "No"
		1 : "Yes"
	]
]

@PointClass = light_sun : "Direct sunlight"
[
	_anglescale(float) : "Angle scale" : "0.5" : "Set the scaling of sunlight brightness due to the angle of incidence with a surface."
	_color(color) : "Color" : "255 255 255" : "Specify red(r), green(g) and blue(b) components for the colour of the light. RGB component values are between 0 and 255 (between 0 and 1 is also accepted)."
	_dirt(choices) : "Ambient occlusion" : 0 : "1 enables dirtmapping (ambient occlusion) on sunlight, -1 to disable (making it illuminate the dirtmapping shadows)." =
	[
		-1 : "Disable"
		0 : "Inherit worldspawn settings"
		1 : "Enable"
	]
	_sun(choices) : "Is sun" : 1 : "Set to 1 to make this entity a sun, as an alternative to using the sunlight worldspawn keys." =
	[
		0 : "No"
		1 : "Yes"
	]
	_suntexture(string) : "Sun texture" : : "This sky light is only emitted from faces with this texture name. Default is to be emitted from all sky textures."

	deviance(float) : "Penumbra width" : "0" : "Specifies the penumbra width, in degrees, of sunlight. Useful values are 3-4 for a gentle soft edge, or 10-20+ for more diffuse sunlight."
	light(integer) : "Brightness" : 300 : "Sunlight brightness."
	mangle(string) : "Angles" : : "Alternate way of specifying sunlight direction."
	target(target_destination) : "Target" : : "If the light targets an info_null entity, the direction towards that entity sets sun direction. The light itself is disabled, so it can be placed anywhere in the map."

	// {{{ GoldSrc-specific.
	// Since there's different entities between compilers we can't just make
	// these bases and inherit them in the game FGDs, so this has to be copied
	// from Half-Life.
	targetname(target_source) : "Name"
	style(choices) : "Appearance" : 0 =
	[
		0 : "Normal"
		10: "Fluorescent flicker"
		2 : "Slow, strong pulse"
		11: "Slow pulse, noblack"
		5 : "Gentle pulse"
		1 : "Flicker A"
		6 : "Flicker B"
		3 : "Candle A"
		7 : "Candle B"
		8 : "Candle C"
		4 : "Fast strobe"
		9 : "Slow strobe"
	]
	pattern(string) : "Custom Appearance"
	// }}}
]

@PointClass = light_sky : "Indirect sky light"
[
	_anglescale(float) : "Angle scale" : "0.5" : "Set the scaling of sunlight brightness due to the angle of incidence with a surface."
	_color(color) : "Color" : "255 255 255" : "Sets the dome light color. Equivalent to worldspawn key _sunlight2_color."
	_dirt(choices) : "Ambient occlusion" : 0 : "1 enables dirtmapping (ambient occlusion) on sunlight2/3, -1 to disable. Default is to use the value of worldspawn “_dirt”." =
	[
		-1 : "Disable"
		0 : "Inherit worldspawn settings"
		1 : "Enable"
	]
	_sunlight2(choices) : "Is sky" : 1 : "Set to 1 to make this entity control the upper dome lighting emitted from sky faces, as an alternative to the worldspawn key _sunlight2. The light entity itself is disabled, so it can be placed anywhere in the map." =
	[
		0 : "No"
		1 : "Yes"
	]
	_sunlight3(choices) : "Is sky from below" : 2 : "Same as _sunlight2, but makes this sky light come from the lower hemisphere." =
	[
		0 : "No"
		1 : "Yes"
	]
	_suntexture(string) : "Sun texture" : : "This sky light is only emitted from faces with this texture name. Default is to be emitted from all sky textures."

	light(integer) : "Brightness" : 0 : "Sets the dome light brightness. Equivalent to worldspawn key _sunlight2."

	// {{{ GoldSrc-specific.
	targetname(target_source) : "Name"
	style(choices) : "Appearance" : 0 =
	[
		0 : "Normal"
		10: "Fluorescent flicker"
		2 : "Slow, strong pulse"
		11: "Slow pulse, noblack"
		5 : "Gentle pulse"
		1 : "Flicker A"
		6 : "Flicker B"
		3 : "Candle A"
		7 : "Candle B"
		8 : "Candle C"
		4 : "Fast strobe"
		9 : "Slow strobe"
	]
	pattern(string) : "Custom Appearance"
	// }}}
]

@SolidClass base(CompilerSolidClassBase) = func_detail : "Solid detail. Can’t be seen inside, splits world faces. Doesn’t seal map." []
@SolidClass base(CompilerSolidClassBase) = func_group : "Bmodel that has no effect; qbsp moves the brushes back into the worldspawn entity.\nThe usefulness comes from the ability to set Model Entity Keys on the brushes inside the func_group." []
@SolidClass base(CompilerSolidClassBase) = func_detail_illusionary : "func_detail variant with no collision (players / monsters / gunfire) and doesn’t split world faces. Doesn’t cast shadows unless enabled with _shadow “1”. Useful for hanging vines. Still creates BSP leafs, which is unavoidable without a new .bsp file format.\nIntersecting func_detail_illusionary brushes don’t clip each other; this is intended to make trees/shrubs/foliage easier with _mirrorinside “1”." []
@SolidClass base(CompilerSolidClassBase) = func_detail_wall : "func_detail variant that doesn’t split world faces. Useful for when you want a decoration touching a floor or wall to not split the floor/wall faces (you’ll get some overdraw instead.) If it completely covers up a world face, that face will get clipped away, so it’s not suitable for fence textures; see func_detail_fence instead.\nIntersecting func_detail_wall brushes don’t clip each other." []
@SolidClass base(CompilerSolidClassBase) = func_detail_fence : "Similar to func_detail_wall except it’s suitable for fence textures, never clips away world faces. Useful for fences, grates, etc., that are solid and block gunfire.\nIntersecting func_detail_fence brushes don’t clip each other." []
